theme_override_colors/font_color = Color(0.913725, 0.94902, 0.980392, 1)
theme_override_font_sizes/font_size = 14
text = "Enter"

[node name="SpacerB" type="Control" parent="Center/ControlsVBox"]
custom_minimum_size = Vector2(0, 12)
layout_mode = 2

[node name="ControlsBackButton" type="Button" parent="Center/ControlsVBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(220, 40)
layout_mode = 2
theme_override_colors/font_color = Color(0.498039, 0.682353, 0.854902, 1)
theme_override_colors/font_hover_color = Color(0.658824, 0.792157, 0.909804, 1)
theme_override_colors/font_pressed_color = Color(0.498039, 0.682353, 0.854902, 1)
theme_override_colors/font_focus_color = Color(0.498039, 0.682353, 0.854902, 1)
theme_override_font_sizes/font_size = 15
theme_override_styles/normal = SubResource("outline_normal")
theme_override_styles/hover = SubResource("outline_hover")
theme_override_styles/pressed = SubResource("outline_normal")
theme_override_styles/focus = SubResource("outline_hover")
text = "Back"

[node name="Hint" type="Label" parent="."]
layout_mode = 1
anchors_preset = 12
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_top = -38.0
offset_bottom = -14.0
grow_horizontal = 2
grow_vertical = 0
theme_override_colors/font_color = Color(0.364706, 0.396078, 0.458824, 1)
theme_override_font_sizes/font_size = 12
text = "WASD to move  ·  Space to attack  ·  Q swap weapon  ·  E camera"
horizontal_alignment = 1

